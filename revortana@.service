[Unit]
Description=Revortana Cortana revival server (%i)
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/revortana-cortana
ExecStart=%h/revortana-cortana/.venv/bin/python %h/revortana-cortana/revortana.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/revortana/openai.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
